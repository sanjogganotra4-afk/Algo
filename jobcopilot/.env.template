# ─────────────────────────────────────────────────────────────
# Job Application Copilot — OPTIONAL settings
#
# You do NOT need this file to run. The copilot works out of the
# box for free, entirely on your laptop, with no API key.
#
# Only create a `.env` (copy of this file) if you want one of the
# optional extras below. `.env` is gitignored and never leaves
# your laptop.
# ─────────────────────────────────────────────────────────────

# --- OPTIONAL: LLM provider ---
# Leave BLANK to use the free local mode (keyword-overlap scoring +
# template cover letters — no internet calls, no account needed).
# Only fill this in if you later want sharper AI scoring and
# genuinely tailored cover letters.
ANTHROPIC_API_KEY=

# Model to use if (and only if) you set a key above. Ignored in free mode.
# Cheaper option: claude-haiku-4-5
JOBCOPILOT_MODEL=claude-opus-4-8

# --- OPTIONAL: Server binding ---
# 0.0.0.0 lets your iPad reach the dashboard on the same Wi-Fi / Tailscale.
# 127.0.0.1 keeps it laptop-only. Defaults to 0.0.0.0:8000 if unset.
JOBCOPILOT_HOST=0.0.0.0
JOBCOPILOT_PORT=8000

# --- OPTIONAL: Telegram notifications ---
# Leave blank to disable. Create a bot with @BotFather to use them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
