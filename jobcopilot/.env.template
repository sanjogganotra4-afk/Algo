# ─────────────────────────────────────────────────────────────
# Job Application Copilot — local secrets
#
# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and never leaves your laptop.
# The copilot NEVER logs or transmits these anywhere except the
# LLM provider you choose below (and only job-description + resume
# text, never these keys).
# ─────────────────────────────────────────────────────────────

# --- LLM provider (used for match scoring, cover letters, Q&A drafts) ---
# The copilot works WITHOUT a key using a keyword-overlap fallback,
# but an LLM key produces much better scores and real cover letters.

# Anthropic (recommended). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model to use (optional). Defaults to a capable Anthropic model.
# Cheaper option: claude-haiku-4-5
JOBCOPILOT_MODEL=claude-opus-4-8

# --- Server ---
# Host 0.0.0.0 makes the dashboard reachable from your iPad on the
# same Wi-Fi (or via Tailscale). Use 127.0.0.1 to keep it laptop-only.
JOBCOPILOT_HOST=0.0.0.0
JOBCOPILOT_PORT=8000

# --- Optional: Telegram notifications ---
# Create a bot with @BotFather, then message it once and get your chat id.
# Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
